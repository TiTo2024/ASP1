@model ASP1.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0">Department: @Model.Name</h3>
        </div>
        <div class="card-body">
            <p><strong>ID:</strong> @Model.Id</p>
            <p><strong>Manager Name:</strong> @Model.MgrName</p>

            <h4 class="mt-4">Students Enrolled</h4>
            <ul class="list-group">
                @if (Model.Students != null && Model.Students.Any())
                {
                    @foreach (var student in Model.Students)
                    {
                        <li class="list-group-item">@student.Name (Age: @student.Age)</li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">No students in this department.</li>
                }
            </ul>
        </div>
        <div class="card-footer">
            <a asp-action="ShowAll" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>