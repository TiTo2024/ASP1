@model IEnumerable<ASP1.Models.Department>

@{
    ViewData["Title"] = "All Departments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>All Departments</h2>
        <a asp-action="Add" class="btn btn-primary">Add New Department</a>
    </div>

    <table class="table table-striped table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Manager Name</th>
                <th>Students Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>@dept.Id</td>
                        <td>@dept.Name</td>
                        <td>@dept.MgrName</td>
                        <td>@(dept.Students?.Count ?? 0)</td>
                        <td>
                            <a asp-action="ShowDetails" asp-route-id="@dept.Id" class="btn btn-info btn-sm text-white">Details</a>
                            <a asp-action="DepartmentReport" asp-route-id="@dept.Id" class="btn btn-warning btn-sm">Report & Dropdown</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No departments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>