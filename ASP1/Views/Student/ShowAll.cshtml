@model PaginatedList<ASP1.Models.Student>

@{
    ViewData["Title"] = "All Students";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>All Students</h2>
        <a asp-action="Add" class="btn btn-success">Add New Student</a>
    </div>

    <!-- Form for Search and Filter -->
    <form asp-action="ShowAll" method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name..." />
        </div>
        <div class="col-md-4">
            <select name="departmentId" asp-items="ViewBag.Departments" class="form-select">
                <option value="">-- All Departments --</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="ShowAll" class="btn btn-secondary">Reset</a>
        </div>
    </form>

    <table class="table table-striped table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.Name</td>
                        <td>@student.Age</td>
                        <td>@(student.Department?.Name ?? "N/A")</td>
                        <td>
                            <a asp-controller="Student" asp-action="ShowDetails" asp-route-id="@student.Id" class="btn btn-info btn-sm text-white">Details</a>
                            <a asp-controller="Student" asp-action="Edit" asp-route-id="@student.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-controller="Student" asp-action="Delete" asp-route-id="@student.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No students found in the database.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Navigation -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="ShowAll" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-departmentId="@ViewBag.SelectedDepartment">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="ShowAll" asp-route-pageNumber="@i" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-departmentId="@ViewBag.SelectedDepartment">@i</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="ShowAll" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-departmentId="@ViewBag.SelectedDepartment">Next</a>
            </li>
        </ul>
    </nav>
</div>