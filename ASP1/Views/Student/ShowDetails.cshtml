@model ASP1.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Student Details: @Model.Name</h3>
        </div>
        <div class="card-body">
            <p><strong>ID:</strong> @Model.Id</p>
            <p><strong>Age:</strong> @Model.Age</p>
            <p><strong>Department:</strong> @(Model.Department?.Name ?? "N/A")</p>

            <h4 class="mt-4">Enrolled Courses & Grades</h4>
            <ul class="list-group mt-2">
                @if (Model.StuCrsResults != null && Model.StuCrsResults.Any())
                {
                    @foreach (var item in Model.StuCrsResults)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @item.Course?.Name
                            <span class="badge bg-success rounded-pill fs-6">Grade: @item.Grade</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">No course results available for this student.</li>
                }
            </ul>
        </div>
        <div class="card-footer">
            <a asp-action="ShowAll" class="btn btn-secondary">Back to All Students</a>
        </div>
    </div>
</div>